{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/status",
      "destination": "/api/index?route=status"
    },
    {
      "source": "/api/start",
      "destination": "/api/index?route=start"
    },
    {
      "source": "/api/stop",
      "destination": "/api/index?route=stop"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?route=home"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
